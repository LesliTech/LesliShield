<%= turbo_frame_tag dom_id(@user, :roles) do %>
    <section class="w-full space-y-8 rounded-2xl border border-neutral-200 bg-white p-5 sm:p-8" aria-label="<%= t("lesli_shield.user_roles.title") %>">
        <header>
            <h2 class="text-lg font-semibold text-neutral-900"><%= t("lesli_shield.user_roles.title") %></h2>
            <p class="mt-1 text-sm text-neutral-500"><%= t("lesli_shield.user_roles.description") %></p>
        </header>

        <% if @role_error.present? %>
            <p role="alert" class="text-sm text-danger-700"><%= @role_error %></p>
        <% end %>

        <% if @available_roles.any? %>
            <%= form_with scope: :user_role, url: user_roles_path(@user),
                builder: LesliView::Forms::Builder,
                data: { turbo_frame: dom_id(@user, :roles) },
                html: { "x-data": "{ roleId: '' }", class: "grid items-end gap-3 sm:grid-cols-[minmax(0,1fr)_auto] [&_.lesli-form-field]:mb-0" } do |form| %>
                <%= form.field_control_select(:role_id,
                    @available_roles.map { |role| [role.name, role.id] },
                    label: t("lesli_shield.user_roles.role"), humanize: false,
                    options: { prompt: t("lesli_shield.user_roles.select_role") },
                    html_options: { required: true, "x-model": "roleId" }) %>
                <%= form.field_control_button(t("lesli_shield.user_roles.add"),
                    { disabled: true, "x-bind:disabled": "!roleId", class: "h-11 w-full" }, icon: "add") %>
            <% end %>
        <% else %>
            <p class="text-sm text-neutral-500"><%= t("lesli_shield.user_roles.no_available_roles") %></p>
        <% end %>

        <div>
            <h3 class="mb-3 flex items-center gap-2 text-sm font-semibold text-neutral-700">
                <%= t("lesli_shield.user_roles.assigned") %>
                <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-500"><%= @user_roles.size %></span>
            </h3>

            <% if @user_roles.empty? %>
                <p class="rounded-xl border border-dashed border-neutral-200 p-6 text-center text-sm text-neutral-500">
                    <%= t("lesli_shield.user_roles.empty") %>
                </p>
            <% else %>
                <ul class="divide-y divide-neutral-100 border-t border-neutral-200">
                    <% @user_roles.each do |assignment| %>
                        <% role = assignment.role %>
                        <li class="flex items-start justify-between gap-4 py-5">
                            <div class="min-w-0">
                                <div class="flex flex-wrap items-center gap-2">
                                    <h4 class="break-words text-sm font-semibold text-neutral-900"><%= role.name %></h4>
                                    <% unless role.active? %>
                                        <span class="rounded-full bg-neutral-100 px-2 py-0.5 text-xs text-neutral-600">
                                            <%= t("lesli_shield.user_roles.inactive") %>
                                        </span>
                                    <% end %>
                                </div>
                                <% if role.description.present? %>
                                    <p class="mt-1 break-words text-sm leading-6 text-neutral-500"><%= role.description %></p>
                                <% end %>
                                <% unless role.active? %>
                                    <p class="mt-1 text-xs text-neutral-500"><%= t("lesli_shield.user_roles.inactive_help") %></p>
                                <% end %>
                            </div>
                            <div class="shrink-0">
                                <% if role.account_id == current_user.account_id && role.permission_level.to_i <= current_user.max_level_permission %>
                                    <%= render LesliView::Elements::Button.new(
                                        t("lesli_shield.user_roles.remove"),
                                        url: user_role_path(@user, assignment), method: :delete,
                                        solid: false, small: true,
                                        data: { turbo_frame: dom_id(@user, :roles),
                                            turbo_confirm: t("lesli_shield.user_roles.confirm_remove",
                                                role: role.name, user: @user.email) }
                                    ) %>
                                <% else %>
                                    <span class="text-xs text-neutral-500"><%= t("lesli_shield.user_roles.read_only") %></span>
                                <% end %>
                            </div>
                        </li>
                    <% end %>
                </ul>
            <% end %>
        </div>
    </section>
<% end %>

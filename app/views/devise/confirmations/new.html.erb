<%= render(
    "devise/shared/application-devise-simple",
    title: I18n.t("lesli_shield.devise/confirmations.view_title")
) do %>

    <%= form_for(
        resource,
        as: resource_name,
        url: user_confirmation_path,
        html: { method: :post, class: "text-left" },
        builder: LesliView::Forms::Builder
    ) do |form| %>

        <p class="mb-6 text-center text-sm leading-6 text-slate-600">
            <%= I18n.t(
                "lesli_shield.devise/confirmations.view_description"
            ) %>
        </p>

        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form.field_control_email(
            :email,
            icon: "mail",
            label: I18n.t(
                "lesli_shield.devise/confirmations.field_email"
            ),
            message: resource.errors[:email].to_sentence.presence,
            category: resource.errors[:email].any? ? :danger : nil,
            value: resource.pending_reconfirmation? ?
                resource.unconfirmed_email : resource.email,
            required: true,
            autofocus: true,
            autocomplete: "email",
            autocapitalize: "none",
            spellcheck: false
        ) %>

        <%= form.field_control_button(
            I18n.t(
                "lesli_shield.devise/confirmations.button_send_instructions"
            ),
            {
                class: "w-full",
                data: {
                    turbo_submits_with: I18n.t(
                        "lesli_shield.devise/confirmations.button_sending"
                    )
                }
            },
            icon: "mark_email_unread"
        ) %>
    <% end %>

    <%= render(
        "devise/shared/links",
        login: true,
        password_reset: false,
        magic_link: false,
        otp: false
    ) %>
<% end %>

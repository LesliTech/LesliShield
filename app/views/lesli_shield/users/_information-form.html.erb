<%
    form_options = {
        model: @user,
        builder: LesliView::Forms::Builder
    }
    form_options[:url] = local_assigns[:form_url] if local_assigns[:form_url]
%>

<%= form_with(**form_options) do |form| %>
    <%= form.fieldset do %>
        <%= form.field_control(:alias) %>
        <%= form.field_control(:title) %>
        <%= form.field_control(:email) %>
        <%= form.field_control(:first_name) %>
        <%= form.field_control(:last_name) %>
        <%= form.field_control(:telephone) %>
        <%= form.field_control_select(:time_zone,
            TZInfo::Timezone.all_identifiers.sort.map { |zone| [zone, zone] },
            humanize: false,
            label: t("lesli_shield.profiles.time_zone"),
            message: t("lesli_shield.profiles.time_zone_help"),
            options: { include_blank: t("lesli_shield.profiles.time_zone_default") }) %>
        <hr/>
        <%= form.field_control_submit %>
    <% end %>        
<% end %>

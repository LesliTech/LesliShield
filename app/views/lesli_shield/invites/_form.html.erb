<%= form_with(model: @invite, builder: LesliView::Forms::Builder) do |form| %>
    <%= form.fieldset do %>
        <%= form.field_control_email(:email) %>
        <%= form.field_control(:full_name) %>
        <%= form.field_control(:telephone) %>
        <%= form.field_control_select(
            :role_id,
            @assignable_roles.pluck(:name, :id),
            label: "Role"
        ) %>
        <%= form.field_control_textarea_rich(:notes) %>
        <hr/>
        <% if @invite.new_record? %>
            <%= form.field_control_button(
                I18n.t("lesli_shield.invites.button_create_and_send"),
                {
                    data: {
                        turbo_submits_with: I18n.t(
                            "lesli_shield.invites.button_creating_and_sending"
                        )
                    }
                }
            ) %>
        <% else %>
            <%= form.field_control_submit %>
        <% end %>
    <% end %>
<% end %>

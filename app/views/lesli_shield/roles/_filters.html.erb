<%= form_with url: roles_path,
    method: :get,
    local: true,
    class: "mb-6 rounded-2xl border border-neutral-200 bg-white p-4 shadow-sm",
    role: "search",
    data: { turbo_frame: "_top" } do %>

    <% %w[perPage orderBy order].each do |parameter| %>
        <%= hidden_field_tag parameter, params[parameter] if params[parameter].present? %>
    <% end %>

    <div class="grid gap-3 lg:grid-cols-[minmax(16rem,1fr)_13rem_13rem_auto] lg:items-end">
        <div>
            <%= label_tag :search,
                t("lesli_shield.roles.filters_search_label"),
                class: "mb-1.5 block text-sm font-medium text-neutral-700" %>
            <div class="relative">
                <span class="material-symbols pointer-events-none absolute left-3 top-1/2 -translate-y-1/2 text-xl text-neutral-400" aria-hidden="true">search</span>
                <%= search_field_tag :search,
                    filters[:search],
                    placeholder: t("lesli_shield.roles.filters_search_placeholder"),
                    autocomplete: "off",
                    class: "h-11 w-full rounded-xl border border-neutral-300 bg-white py-2 pl-10 pr-10 text-sm text-neutral-900 outline-none transition placeholder:text-neutral-400 hover:border-neutral-400 focus:border-primary focus:ring-4 focus:ring-primary/10" %>
                <% if filters[:search].present? %>
                    <%= link_to roles_path(request.query_parameters.except("search", "page")),
                        class: "absolute right-2 top-1/2 inline-flex h-7 w-7 -translate-y-1/2 items-center justify-center rounded-lg text-neutral-400 transition hover:bg-neutral-100 hover:text-neutral-700",
                        data: { turbo_frame: "_top" },
                        aria: { label: t("lesli_shield.roles.filters_clear_search") } do %>
                        <span class="material-symbols text-lg" aria-hidden="true">close</span>
                    <% end %>
                <% end %>
            </div>
        </div>

        <div>
            <%= label_tag :status,
                t("lesli_shield.roles.filters_status_label"),
                class: "mb-1.5 block text-sm font-medium text-neutral-700" %>
            <%= select_tag :status,
                options_for_select([
                    [t("lesli_shield.roles.filters_status_all"), ""],
                    [t("lesli_shield.roles.statuses_active"), "active"],
                    [t("lesli_shield.roles.statuses_inactive"), "inactive"]
                ], filters[:status]),
                class: "h-11 w-full rounded-xl border border-neutral-300 bg-white px-3 text-sm text-neutral-700 outline-none transition hover:border-neutral-400 focus:border-primary focus:ring-4 focus:ring-primary/10" %>
        </div>

        <div>
            <%= label_tag :type,
                t("lesli_shield.roles.filters_type_label"),
                class: "mb-1.5 block text-sm font-medium text-neutral-700" %>
            <%= select_tag :type,
                options_for_select([
                    [t("lesli_shield.roles.filters_type_all"), ""],
                    [t("lesli_shield.roles.types_system"), "system"],
                    [t("lesli_shield.roles.types_custom"), "custom"]
                ], filters[:type]),
                class: "h-11 w-full rounded-xl border border-neutral-300 bg-white px-3 text-sm text-neutral-700 outline-none transition hover:border-neutral-400 focus:border-primary focus:ring-4 focus:ring-primary/10" %>
        </div>

        <%= render LesliView::Elements::Button.new(
            t("lesli_shield.roles.filters_submit"), type: :submit, icon: "filter_alt",
            data: { turbo_submits_with: t("lesli_shield.roles.filters_loading") }
        ) %>
    </div>
<% end %>

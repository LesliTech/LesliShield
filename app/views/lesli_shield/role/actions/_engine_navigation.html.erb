<%
engines = [
    { slug: nil, label: t("lesli_shield.roles.permissions.all_engines"), count: @permission_engines.sum { |engine| engine[:count] } },
    *@permission_engines
]
%>
<nav class="rounded-xl border border-slate-200 bg-white p-3 shadow-sm lg:sticky lg:top-4" aria-label="<%= t("lesli_shield.roles.permissions.engine_navigation") %>">
    <p class="px-3 pb-2 text-xs font-semibold uppercase tracking-wide text-slate-500">
        <%= t("lesli_shield.roles.permissions.engines") %>
    </p>
    <ul class="space-y-1">
        <% engines.each do |engine| %>
            <%
            selected = @engine_slug == engine[:slug]
            path = if engine[:slug]
                engine_role_actions_path(@role, engine_slug: engine[:slug], search: @search.presence)
            else
                role_actions_path(@role, search: @search.presence)
            end
            %>
            <li>
                <%= link_to path,
                    class: class_names(
                        "flex min-h-11 items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm font-medium transition focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-sky-500/20",
                        "bg-sky-50 text-sky-700" => selected,
                        "text-slate-700 hover:bg-slate-100" => !selected
                    ),
                    aria: { current: ("page" if selected) },
                    data: { turbo_frame: "_top" } do %>
                    <span class="truncate"><%= engine[:label] %></span>
                    <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-600"><%= engine[:count] %></span>
                <% end %>
            </li>
        <% end %>
    </ul>
</nav>

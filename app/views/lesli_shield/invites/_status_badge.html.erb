<%
status = invite.lifecycle_status
status_classes = {
    "pending" => "bg-amber-50 text-amber-700 ring-amber-600/20",
    "accepted" => "bg-emerald-50 text-emerald-700 ring-emerald-600/20",
    "cancelled" => "bg-slate-100 text-slate-600 ring-slate-500/20",
    "expired" => "bg-rose-50 text-rose-700 ring-rose-600/20"
}
%>

<span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset <%= status_classes.fetch(status) %>">
    <%= I18n.t("lesli_shield.invites.statuses.#{status}") %>
</span>

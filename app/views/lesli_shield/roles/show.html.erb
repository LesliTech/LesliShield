<%
members_count = @role_summary.fetch(:members)
members_plural = members_count == 1 ? "one" : "other"
%>

<%= render LesliView::Layout::Container.new("shield-role-detail") do %>
    <%= render LesliView::Components::Header.new(
        @role.name,
        @role.description.presence || t("lesli_shield.roles.description_missing"),
        back: roles_path
    ) do %>
        <%= render LesliView::Elements::Button.new(
            t("lesli_shield.roles.detail_view_members"), icon: "group", url: users_path
        ) %>
        <% unless @role.protected_role? %>
            <%= render LesliView::Elements::Button.new(
                t("lesli_shield.roles.detail_manage_permissions"), icon: "key", url: role_actions_path(@role)
            ) %>
        <% end %>
        <%= render LesliView::Elements::Button.new(
            t("lesli_shield.roles.action_duplicate"),
            icon: "content_copy", url: duplicate_role_path(@role), method: :post,
            data: { turbo_submits_with: t("lesli_shield.roles.action_duplicating") }
        ) %>

    <% end %>

    <%
    navigation_items = [{ label: t("lesli_shield.roles.detail_summary_title"), path: role_path(@role), selected: true }]
    unless @role.protected_role?
        navigation_items << { label: t("lesli_shield.roles.detail_manage_permissions"), path: role_actions_path(@role), selected: false }
    end
    %>
    <div class="flex min-w-0 flex-col gap-6 lg:flex-row lg:items-start">
        <%= render LesliView::Layout::NavigationSidebar.new(items: navigation_items, label: @role.name) %>
        <div id="role-detail-content" class="min-w-0 flex-1 space-y-6">
            <section id="members" class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="role-summary-title">
                <div class="flex items-center justify-between gap-3">
                    <h2 id="role-summary-title" class="text-base font-semibold text-neutral-900">
                        <%= t("lesli_shield.roles.detail_summary_title") %>
                    </h2>
                    <%= render "status_badge", role: @role %>
                </div>

                <dl class="mt-3 flex flex-wrap gap-8">
                    <div>
                        <dt class="text-xs font-medium uppercase tracking-wide text-neutral-500">
                            <%= t("lesli_shield.roles.detail_members") %>
                        </dt>
                        <dd class="mt-1 text-2xl font-semibold text-neutral-900">
                            <%= @role_summary.fetch(:members) %>
                        </dd>
                    </div>
                    <div>
                        <dt class="text-xs font-medium uppercase tracking-wide text-neutral-500">
                            <%= t("lesli_shield.roles.detail_permissions") %>
                        </dt>
                        <dd class="mt-1 text-2xl font-semibold text-neutral-900">
                            <%= @role_summary.fetch(:permissions) %>
                        </dd>
                    </div>
                </dl>

                <div class="mt-5 border-t border-neutral-200 pt-5">
                    <h3 id="role-status-title" class="text-sm font-semibold text-neutral-800">
                        <%= t("lesli_shield.roles.detail_status_title") %>
                    </h3>
                    <p class="mt-2 text-sm leading-6 text-neutral-500">
                        <%= @role.active? ?
                            t("lesli_shield.roles.detail_active_impact_#{members_plural}", count: members_count) :
                            t("lesli_shield.roles.detail_inactive_impact_#{members_plural}", count: members_count) %>
                    </p>
                </div>
            </section>

            <section id="general" class="rounded-2xl border border-neutral-200 bg-white p-5 shadow-sm sm:p-8">
                <%= render "form" %>
            </section>

        </div>
    </div>
<% end %>

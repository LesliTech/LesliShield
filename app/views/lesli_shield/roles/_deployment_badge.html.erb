<%
status = role.permissions_deployment_status
styles = {
    pending: "bg-warning-100 text-warning-800 ring-warning-200",
    deployed: "bg-success-100 text-success-700 ring-success-200",
    never_deployed: "bg-neutral-100 text-neutral-600 ring-neutral-200"
}
%>

<span
    class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset <%= styles.fetch(status) %>"
    data-role-deployment-status="<%= status %>"
>
    <%= t("lesli_shield.roles.deployment_statuses_#{status}") %>
</span>

<%
status = invite.lifecycle_status
status_classes = {
    "pending" => "bg-warning-50 text-warning-700 ring-warning-600/20",
    "accepted" => "bg-success-50 text-success-700 ring-success-600/20",
    "cancelled" => "bg-neutral-100 text-neutral-600 ring-neutral-500/20",
    "expired" => "bg-danger-50 text-danger-700 ring-danger-600/20"
}
%>

<span class="inline-flex items-center rounded-full px-2.5 py-1 text-xs font-semibold ring-1 ring-inset <%= status_classes.fetch(status) %>">
    <%= I18n.t("lesli_shield.invites.statuses_#{status}") %>
</span>

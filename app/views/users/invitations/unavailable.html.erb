<%= render(
    "devise/shared/application-devise",
    title: @invitation_error_title,
    back_to_login: true
) do %>
    <section class="rounded-2xl border border-slate-200 bg-white p-6 text-center shadow-sm" role="alert">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-amber-50 text-amber-700">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M12 8v5m0 3.5v.01M10.3 4.4 3.6 16a2 2 0 0 0 1.7 3h13.4a2 2 0 0 0 1.7-3L13.7 4.4a2 2 0 0 0-3.4 0Z" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
        </div>
        <p class="mt-4 text-sm leading-6 text-slate-600">
            <%= @invitation_error_description %>
        </p>
        <%= link_to I18n.t("actions.back_to_login", default: "Back to login"),
            new_user_session_path,
            class: "mt-6 inline-flex h-11 w-full items-center justify-center rounded-xl bg-sky-600 px-4 text-sm font-semibold text-white shadow-sm transition hover:bg-sky-700 focus:outline-none focus:ring-4 focus:ring-sky-500/20" %>
    </section>
<% end %>

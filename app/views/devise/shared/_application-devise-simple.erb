<% title = local_assigns.fetch(:title, "") %>

<main id="lesli-application" class="min-h-screen bg-white">
    <section class="flex min-h-screen flex-col">
        <header class="shrink-0 px-6 pb-12 pt-20 text-center sm:pb-16 sm:pt-32">
            <div>
                <%= image_tag(
                    "lesli_assets/brand/app-auth.svg",
                    class: "#{lesli_instance_code}-logo mx-auto mb-4 h-auto w-auto max-w-[130px]",
                    alt: I18n.t("lesli_shield.authentication.logo_alt", default: "Application logo")
                )
                %>

                <% if title.present? %>
                    <h1 class="text-2xl font-semibold tracking-tight text-[var(--lesli-color-primary)]">
                        <%= title %>
                    </h1>
                <% end %>
            </div>
        </header>

        <div class="flex flex-1 flex-col items-center border-t border-slate-200 bg-slate-50 px-6 py-8 [&>form]:my-8 [&>form]:w-full [&>form]:max-w-[750px] [&>form]:rounded-xl [&>form]:border [&>form]:border-slate-200 [&>form]:bg-white [&>form]:p-8 [&>form]:shadow-sm sm:[&>form]:p-16">
            <%= yield %>
        </div>
    </section>
</main>

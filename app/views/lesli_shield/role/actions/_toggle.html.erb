<%
enabled = action[:assigned]
route_options = { search: @search.presence }
route_options[:engine_slug] = @engine_slug if @engine_slug
path = if enabled
    role_action_path(@role, action[:id], **route_options)
else
    role_actions_path(@role, **route_options)
end
method = enabled ? :delete : :post
request_params = enabled ? {} : { action_id: action[:id] }
label = t(
    "lesli_shield.roles.permissions_toggle",
    action: action[:display_label],
    state: t("lesli_shield.roles.permissions_states_#{enabled ? 'enabled' : 'disabled'}")
)
%>

<%= button_to(
    path,
    method: method,
    params: request_params,
    form: { class: "shrink-0" },
    class: class_names(
        "inline-flex size-6 items-center justify-center rounded-md border transition focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/20",
        "border-primary bg-primary text-white hover:bg-primary-strong" => enabled,
        "border-neutral-300 bg-white text-transparent hover:border-primary" => !enabled
    ),
    role: "switch",
    aria: { checked: enabled, label: label },
    data: { turbo_submits_with: "…" }
) do %>
    <span class="material-symbols text-lg" aria-hidden="true">check</span>
<% end %>

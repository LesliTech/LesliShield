<div id="shield-profile-password-form" class="max-w-2xl">
    <p class="mb-6 text-sm leading-6 text-slate-600">
        <%= I18n.t("lesli_shield.profiles.password_description") %>
    </p>

    <%= form_with(
        model: user,
        url: profile_password_path,
        method: :patch,
        builder: LesliView::Forms::Builder
    ) do |form| %>
        <%= form.fieldset do %>
            <%= form.field_control_password(
                :current_password,
                label: I18n.t("lesli_shield.profiles.current_password"),
                message: user.errors[:current_password].to_sentence.presence,
                category: user.errors[:current_password].any? ? :danger : nil,
                icon: "lock",
                required: true,
                autocomplete: "current-password",
                value: ""
            ) %>

            <%= form.field_control_password(
                :password,
                label: I18n.t("lesli_shield.profiles.new_password"),
                message: user.errors[:password].to_sentence.presence ||
                    I18n.t(
                        "lesli_shield.profiles.password_hint",
                        minimum: Devise.password_length.min,
                        maximum: Devise.password_length.max
                    ),
                category: user.errors[:password].any? ? :danger : nil,
                icon: "key",
                required: true,
                autocomplete: "new-password",
                minlength: Devise.password_length.min,
                maxlength: Devise.password_length.max,
                value: ""
            ) %>

            <%= form.field_control_password(
                :password_confirmation,
                label: I18n.t("lesli_shield.profiles.password_confirmation"),
                message: user.errors[:password_confirmation].to_sentence.presence,
                category: user.errors[:password_confirmation].any? ? :danger : nil,
                icon: "key",
                required: true,
                autocomplete: "new-password",
                minlength: Devise.password_length.min,
                maxlength: Devise.password_length.max,
                value: ""
            ) %>

            <%= form.field_control_button(
                I18n.t("lesli_shield.profiles.change_password"),
                {
                    data: {
                        turbo_submits_with: I18n.t(
                            "lesli_shield.profiles.changing_password"
                        )
                    }
                },
                icon: "key"
            ) %>
        <% end %>
    <% end %>
</div>

<%
recipient = @invite.full_name.presence || @invite.email
%>

<%= render LesliView::Layout::Container.new("shield-invites") do %>
    <%= render LesliView::Components::Header.new(
        I18n.t("lesli_shield.invites.detail_title", recipient: recipient),
        nil,
        back: invites_path
    ) do %>
        <%= render "invite_actions", invite: @invite, show_view: false %>
    <% end %>

    <%= render "invite", invite: @invite %>
<% end %>

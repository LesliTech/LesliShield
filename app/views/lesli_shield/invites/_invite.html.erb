<%
format_time = lambda do |value|
    value.present? ? I18n.l(value, format: :long) : "—"
end

inviter_name = invite.invited_by.full_name.to_s.strip.presence ||
    invite.invited_by.email

details = [
    [I18n.t("lesli_shield.invites.detail_email"), invite.email],
    [
        I18n.t("lesli_shield.invites.detail_name"),
        invite.full_name.presence || I18n.t("lesli_shield.invites.value_not_available")
    ],
    [
        I18n.t("lesli_shield.invites.detail_role"),
        invite.role&.name || I18n.t("lesli_shield.invites.value_not_available")
    ],
    [I18n.t("lesli_shield.invites.detail_invited_by"), inviter_name],
    [I18n.t("lesli_shield.invites.detail_sent_at"), format_time.call(invite.sent_at)],
    [I18n.t("lesli_shield.invites.detail_expires_at"), format_time.call(invite.expires_at)],
    [I18n.t("lesli_shield.invites.detail_accepted_at"), format_time.call(invite.accepted_at)],
    [I18n.t("lesli_shield.invites.detail_cancelled_at"), format_time.call(invite.cancelled_at)]
]
%>

<article id="<%= dom_id invite %>" class="overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm">
    <div class="flex flex-col gap-3 border-b border-slate-200 bg-slate-50 px-6 py-5 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <p class="text-sm font-medium text-slate-500">
                <%= I18n.t("lesli_shield.invites.detail_recipient") %>
            </p>
            <p class="mt-1 text-lg font-semibold text-slate-900">
                <%= invite.full_name.presence || invite.email %>
            </p>
        </div>
        <%= render "status_badge", invite: invite %>
    </div>

    <dl class="grid grid-cols-1 sm:grid-cols-2">
        <% details.each do |label, value| %>
            <div class="border-b border-slate-100 px-6 py-5 sm:odd:border-r">
                <dt class="text-sm font-medium text-slate-500"><%= label %></dt>
                <dd class="mt-1 break-words text-sm font-semibold text-slate-900"><%= value %></dd>
            </div>
        <% end %>
    </dl>

    <div class="px-6 py-5">
        <h2 class="text-sm font-medium text-slate-500">
            <%= I18n.t("lesli_shield.invites.detail_message") %>
        </h2>
        <p class="mt-2 whitespace-pre-wrap text-sm leading-6 text-slate-700"><%= invite.notes.presence || "—" %></p>
    </div>
</article>

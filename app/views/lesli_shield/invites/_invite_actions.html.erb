<%
show_view = local_assigns.fetch(:show_view, false)
action_classes = "inline-flex h-9 items-center justify-center rounded-lg border px-3 text-xs font-semibold transition focus:outline-none focus:ring-4"
%>

<div class="flex flex-wrap items-center gap-2">
    <% if show_view %>
        <%= link_to I18n.t("lesli_shield.invites.action_view"),
            invite_path(invite),
            class: "#{action_classes} border-neutral-200 bg-white text-neutral-700 hover:bg-neutral-50 focus:ring-neutral-500/10" %>
    <% end %>

    <% if invite.resend_available? %>
        <%= button_to I18n.t("lesli_shield.invites.action_resend"),
            resend_invite_path(invite),
            method: :post,
            form: { class: "inline" },
            class: "#{action_classes} border-primary-muted bg-primary-soft text-primary-strong hover:border-primary focus:ring-primary/20",
            data: {
                turbo_confirm: I18n.t("lesli_shield.invites.confirm_resend")
            } %>
    <% end %>

    <% if invite.cancellable? %>
        <%= button_to I18n.t("lesli_shield.invites.action_cancel"),
            cancel_invite_path(invite),
            method: :patch,
            form: { class: "inline" },
            class: "#{action_classes} border-danger-200 bg-danger-50 text-danger-700 hover:bg-danger-100 focus:ring-danger-500/10",
            data: {
                turbo_confirm: I18n.t("lesli_shield.invites.confirm_cancel")
            } %>
    <% end %>
</div>

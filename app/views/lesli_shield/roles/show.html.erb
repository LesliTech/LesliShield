<%= render LesliView::Layout::Container.new("shield-role-detail") do %>
    <%= render LesliView::Components::Header.new(
        @role.name,
        @role.description.presence || t("lesli_shield.roles.description_missing"),
        back: roles_path
    ) do %>
        <%= link_to users_path,
            class: "inline-flex h-10 items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700 focus:outline-none focus:ring-4 focus:ring-sky-500/10",
            data: { turbo_frame: "_top" } do %>
            <span class="material-symbols text-lg" aria-hidden="true">group</span>
            <span><%= t("lesli_shield.roles.detail.view_members") %></span>
        <% end %>

        <% unless @role.protected_role? %>
            <%= link_to role_actions_path(@role),
                class: "inline-flex h-10 items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700 focus:outline-none focus:ring-4 focus:ring-sky-500/10",
                data: { turbo_frame: "_top" } do %>
                <span class="material-symbols text-lg" aria-hidden="true">key</span>
                <span><%= t("lesli_shield.roles.detail.manage_permissions") %></span>
            <% end %>
        <% end %>

        <%= button_to duplicate_role_path(@role),
            method: :post,
            form: { data: { turbo_frame: "_top" } },
            class: "inline-flex h-10 items-center justify-center gap-2 rounded-xl border border-slate-300 bg-white px-4 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-sky-300 hover:bg-sky-50 hover:text-sky-700 focus:outline-none focus:ring-4 focus:ring-sky-500/10 disabled:cursor-wait disabled:opacity-70",
            data: { turbo_submits_with: t("lesli_shield.roles.action_duplicating") } do %>
            <span class="material-symbols text-xl" aria-hidden="true">content_copy</span>
            <span><%= t("lesli_shield.roles.action_duplicate") %></span>
        <% end %>

    <% end %>

    <div id="role-detail-content" class="w-full space-y-6">
        <section id="members" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6" aria-labelledby="role-summary-title">
            <div class="flex items-center justify-between gap-3">
                <h2 id="role-summary-title" class="text-base font-semibold text-slate-900">
                    <%= t("lesli_shield.roles.detail.summary_title") %>
                </h2>
                <%= render "status_badge", role: @role %>
            </div>

            <dl class="mt-3 flex flex-wrap gap-8">
                <div>
                    <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">
                        <%= t("lesli_shield.roles.detail.members") %>
                    </dt>
                    <dd class="mt-1 text-2xl font-semibold text-slate-900">
                        <%= @role_summary.fetch(:members) %>
                    </dd>
                </div>
                <div>
                    <dt class="text-xs font-medium uppercase tracking-wide text-slate-500">
                        <%= t("lesli_shield.roles.detail.permissions") %>
                    </dt>
                    <dd class="mt-1 text-2xl font-semibold text-slate-900">
                        <%= @role_summary.fetch(:permissions) %>
                    </dd>
                </div>
            </dl>

            <div class="mt-5 border-t border-slate-200 pt-5">
                <h3 id="role-status-title" class="text-sm font-semibold text-slate-800">
                    <%= t("lesli_shield.roles.detail.status_title") %>
                </h3>
                <p class="mt-2 text-sm leading-6 text-slate-500">
                    <%= @role.active? ?
                        t("lesli_shield.roles.detail.active_impact", count: @role_summary.fetch(:members)) :
                        t("lesli_shield.roles.detail.inactive_impact", count: @role_summary.fetch(:members)) %>
                </p>
            </div>
        </section>

        <section id="general" class="rounded-2xl border border-slate-200 bg-white p-5 shadow-sm sm:p-8">
            <%= render "form" %>
        </section>

    </div>
<% end %>

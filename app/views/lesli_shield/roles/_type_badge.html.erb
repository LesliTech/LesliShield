<% if role.system_role? %>
    <span class="inline-flex items-center rounded-full bg-bugambilia-100 px-2.5 py-1 text-xs font-semibold text-bugambilia-700 ring-1 ring-inset ring-bugambilia-500/20">
        <%= t("lesli_shield.roles.types_system") %>
    </span>
<% else %>
    <span class="inline-flex items-center rounded-full bg-neutral-50 px-2.5 py-1 text-xs font-semibold text-neutral-700 ring-1 ring-inset ring-neutral-600/20">
        <%= t("lesli_shield.roles.types_custom") %>
    </span>
<% end %>

<%
title = I18n.t("overrides.lesli_shield.devise/registrations.view_title",
        default: :"lesli_shield.devise/registrations.view_title")
%>

<%= render("devise/shared/application-devise", title: title) do %>

    <%= form_for(
        resource,
        as: resource_name,
        url: user_registration_path,
        html: { class: "text-left" },
        builder: LesliView::Forms::Builder
    ) do |form| %>

        <p class="mb-6 text-center text-sm leading-6 text-slate-600">
            <%= I18n.t("lesli_shield.devise/registrations.view_description") %>
        </p>

        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form.field_control_email(
            :email,
            label: I18n.t("lesli_shield.devise/registrations.label_email"),
            message: resource.errors[:email].to_sentence.presence,
            category: resource.errors[:email].any? ? :danger : nil,
            icon: "person",
            autofocus: true,
            autocomplete: "email",
            required: true,
            autocapitalize: "none",
            spellcheck: false
        ) %>

        <%= form.field_control_password(
            :password,
            label: I18n.t("lesli_shield.devise/registrations.label_password"),
            message: resource.errors[:password].to_sentence.presence ||
                I18n.t(
                    "lesli_shield.devise/registrations.view_password_length",
                    minimum: @minimum_password_length,
                    maximum: Devise.password_length.max
                ),
            category: resource.errors[:password].any? ? :danger : nil,
            icon: "key",
            autocomplete: "new-password",
            required: true,
            minlength: @minimum_password_length,
            maxlength: Devise.password_length.max,
            value: ""
        ) %>

        <%= form.field_control_password(
            :password_confirmation,
            label: I18n.t(
                "lesli_shield.devise/registrations.label_password_confirmation"
            ),
            message: resource.errors[:password_confirmation].to_sentence.presence,
            category: resource.errors[:password_confirmation].any? ? :danger : nil,
            icon: "key",
            autocomplete: "new-password",
            required: true,
            minlength: @minimum_password_length,
            maxlength: Devise.password_length.max,
            value: ""
        ) %>

        <div class="mb-4">
            <p class="text-left text-xs leading-5 text-slate-500">
                <%= I18n.t("lesli_shield.devise/registrations.view_legal_notice") %>
            </p>
        </div>

        <%= form.field_control_button(
            I18n.t(
                "overrides.lesli_shield.devise/registrations.button_create_account",
                default: :"lesli_shield.devise/registrations.button_create_account"
            ),
            {
                class: "w-full",
                data: {
                    turbo_submits_with: I18n.t(
                        "lesli_shield.devise/registrations.button_creating_account"
                    )
                }
            },
            icon: "person_add"
        ) %>

        <p class="mt-1 text-center text-sm text-slate-600">
            <%= I18n.t("lesli_shield.devise/registrations.view_already_have_an_account") %>
            <%= link_to(
                I18n.t("lesli_shield.devise/registrations.button_login"),
                new_user_session_path,
                class: "font-semibold text-[var(--lesli-color-primary)] underline underline-offset-2 hover:opacity-80 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--lesli-color-primary)]"
            ) %>
        </p>
    <% end %>
<% end %>

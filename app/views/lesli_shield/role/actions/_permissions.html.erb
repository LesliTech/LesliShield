<%
index_path = if @engine_slug
    engine_role_actions_path(@role, engine_slug: @engine_slug)
else
    role_actions_path(@role)
end

navigation_items = [{
    label: t("lesli_shield.roles.detail_summary_title"),
    path: role_path(@role),
    selected: false
}]
engines = [
    {
        slug: nil,
        label: t("lesli_shield.roles.permissions_all_engines"),
        count: @permission_engines.sum { |engine| engine[:count] }
    },
    *@permission_engines
]
engines.each do |engine|
    path = if engine[:slug]
        engine_role_actions_path(@role, engine_slug: engine[:slug], search: @search.presence)
    else
        role_actions_path(@role, search: @search.presence)
    end
    navigation_items << {
        label: engine[:label],
        count: engine[:count],
        path: path,
        selected: @engine_slug == engine[:slug]
    }
end
%>

<div id="shield-role-permissions" class="flex min-w-0 flex-col gap-6 lg:flex-row lg:items-start">
    <%= render LesliView::Layout::NavigationSidebar.new(
        items: navigation_items,
        label: t("lesli_shield.roles.permissions_engine_navigation")
    ) %>
    <div class="min-w-0 flex-1 space-y-6">
        <section class="rounded-xl border border-neutral-200 bg-white p-4 shadow-sm sm:p-5" aria-labelledby="permission-tools-title">
            <h2 id="permission-tools-title" class="sr-only">
                <%= t("lesli_shield.roles.permissions_tools") %>
            </h2>

            <%= form_with(
                url: index_path,
                method: :get,
                data: { turbo_frame: "_top" },
                class: "flex flex-col gap-3 sm:flex-row sm:items-end"
            ) do |form| %>
                <div class="min-w-0 flex-1">
                    <%= form.label :search,
                        t("lesli_shield.roles.permissions_search_label"),
                        class: "block text-sm font-medium text-neutral-700" %>
                    <div class="relative mt-1.5">
                        <span class="pointer-events-none absolute inset-y-0 left-3 flex items-center text-neutral-400" aria-hidden="true">
                            <span class="material-symbols">search</span>
                        </span>
                        <%= form.search_field :search,
                            value: @search,
                            autocomplete: "off",
                            class: "block min-h-11 w-full rounded-xl border border-neutral-300 bg-white py-2.5 pl-10 pr-3 text-sm text-neutral-900 shadow-sm outline-none transition placeholder:text-neutral-400 focus:border-primary focus:ring-4 focus:ring-primary/10",
                            placeholder: t("lesli_shield.roles.permissions_search_placeholder") %>
                    </div>
                </div>
                <div class="flex gap-2">
                    <%= render LesliView::Elements::Button.new(t("lesli_shield.roles.permissions_search"), type: :submit, icon: "search") %>
                    <% if @search.present? %>
                        <%= link_to t("lesli_shield.roles.permissions_clear_search"),
                            index_path,
                            data: { turbo_frame: "_top" },
                            class: "inline-flex min-h-11 items-center justify-center rounded-xl border border-neutral-300 bg-white px-4 py-2 text-sm font-semibold text-neutral-700 transition hover:bg-neutral-50 focus-visible:outline-none focus-visible:ring-4 focus-visible:ring-primary/20" %>
                    <% end %>
                </div>
            <% end %>
        </section>

        <div class="min-w-0 space-y-4">
            <% if @permission_matrix.any? %>
                <%= render "matrix" %>
            <% else %>
                <div class="rounded-xl border border-dashed border-neutral-300 bg-neutral-50 px-6 py-10 text-center">
                    <% if @search.present? %>
                        <p class="text-sm font-semibold text-neutral-800"><%= t("lesli_shield.roles.permissions_no_matches") %></p>
                        <p class="mt-1 text-sm text-neutral-500"><%= t("lesli_shield.roles.permissions_no_matches_hint") %></p>
                    <% else %>
                        <p class="text-sm font-medium text-neutral-700"><%= t("lesli_shield.roles.permissions_empty") %></p>
                    <% end %>
                </div>
            <% end %>
        </div>
    </div>
</div>


<fieldset data-demo-credentials class="mb-8 rounded-xl border border-info-200 bg-info-50 px-4 pb-4 text-sm text-info-900">
    <legend class="px-2 font-semibold text-info-800">
        <%= I18n.t("lesli_shield.devise_sessions.demo_title") %>
    </legend>
    <dl class="mt-1 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
        <dt class="font-medium"><%= I18n.t("lesli_shield.devise_sessions.demo_email") %>:</dt>
        <dd class="break-all"><%= credentials.fetch(:email) %></dd>
        <dt class="font-medium"><%= I18n.t("lesli_shield.devise_sessions.demo_password") %>:</dt>
        <dd><%= credentials.fetch(:password) %></dd>
    </dl>
</fieldset>

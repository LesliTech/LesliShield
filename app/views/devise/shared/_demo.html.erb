
<fieldset data-demo-credentials class="mb-8 rounded-xl border border-sky-200 bg-sky-50 px-4 pb-4 text-sm text-sky-950">
    <legend class="px-2 font-semibold text-sky-800">
        <%= I18n.t("lesli_shield.devise/sessions.demo_title") %>
    </legend>
    <dl class="mt-1 grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
        <dt class="font-medium"><%= I18n.t("lesli_shield.devise/sessions.demo_email") %>:</dt>
        <dd class="break-all"><%= credentials.fetch(:email) %></dd>
        <dt class="font-medium"><%= I18n.t("lesli_shield.devise/sessions.demo_password") %>:</dt>
        <dd><%= credentials.fetch(:password) %></dd>
    </dl>
</fieldset>

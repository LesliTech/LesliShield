<% if role.system_role? %>
    <span class="inline-flex items-center rounded-full bg-violet-50 px-2.5 py-1 text-xs font-semibold text-violet-700 ring-1 ring-inset ring-violet-600/20">
        <%= t("lesli_shield.roles.types_system") %>
    </span>
<% else %>
    <span class="inline-flex items-center rounded-full bg-sky-50 px-2.5 py-1 text-xs font-semibold text-sky-700 ring-1 ring-inset ring-sky-600/20">
        <%= t("lesli_shield.roles.types_custom") %>
    </span>
<% end %>

<%
editable = @role.new_record? || @role_editable
input_classes = "mt-1.5 block w-full rounded-xl border border-neutral-300 bg-white px-3 py-2.5 text-sm text-neutral-900 shadow-sm outline-none transition placeholder:text-neutral-400 hover:border-neutral-400 focus:border-primary focus:ring-4 focus:ring-primary/10 disabled:cursor-not-allowed disabled:bg-neutral-50 disabled:text-neutral-500"
error_input_classes = "border-danger-400 focus:border-danger-500 focus:ring-danger-500/10"
members_count = @role_summary&.fetch(:members, 0).to_i
members_plural = members_count == 1 ? "one" : "other"
%>

<div id="role-form">
    <%= form_with model: @role,
        id: "role-form-fields",
        class: "space-y-6",
        data: { turbo: true, turbo_frame: "_top" } do |form| %>
        <% if @role.errors.any? %>
            <div class="rounded-xl border border-danger-200 bg-danger-50 p-4" role="alert">
                <div class="flex gap-3">
                    <span class="material-symbols text-danger-500" aria-hidden="true">error</span>
                    <div>
                        <h2 class="text-sm font-semibold text-danger-800">
                            <%= t("lesli_shield.roles.form_errors_title") %>
                        </h2>
                        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-danger-700">
                            <% @role.errors.full_messages.each do |message| %>
                                <li><%= message %></li>
                            <% end %>
                        </ul>
                    </div>
                </div>
            </div>
        <% end %>

        <div class="space-y-5">
            <div>
                <%= form.label :name, t("lesli_shield.roles.fields_name"), class: "block text-sm font-medium text-neutral-700" %>
                <%= form.text_field :name,
                    autofocus: @role.new_record?,
                    disabled: !editable,
                    autocomplete: "off",
                    class: class_names(input_classes, error_input_classes => @role.errors[:name].any?) %>
                <%= render "field_errors", record: @role, attribute: :name %>
            </div>

            <div>
                <%= form.label :description, t("lesli_shield.roles.fields_description"), class: "block text-sm font-medium text-neutral-700" %>
                <%= form.text_area :description,
                    rows: 4,
                    disabled: !editable,
                    class: class_names(input_classes, "resize-y", error_input_classes => @role.errors[:description].any?) %>
                <p class="mt-1.5 text-xs leading-5 text-neutral-500">
                    <%= t("lesli_shield.roles.form_description_hint") %>
                </p>
                <%= render "field_errors", record: @role, attribute: :description %>
            </div>
        </div>

        <% if @role.new_record? %>
            <fieldset class="border-t border-neutral-200 pt-6">
                <legend class="text-sm font-medium text-neutral-700">
                    <%= t("lesli_shield.roles.fields_status") %>
                </legend>

                <div class="mt-3 grid gap-3 sm:grid-cols-2">
                    <% [true, false].each do |active| %>
                        <label class="relative flex cursor-pointer gap-3 rounded-xl border border-neutral-200 bg-white p-4 transition hover:border-primary-muted hover:bg-primary-soft/40 has-[:checked]:border-primary has-[:checked]:ring-4 has-[:checked]:ring-primary/10">
                            <%= form.radio_button :active,
                                active,
                                class: "mt-0.5 h-4 w-4 border-neutral-300 text-primary focus:ring-primary" %>
                            <span>
                                <span class="block text-sm font-semibold text-neutral-900">
                                    <%= t("lesli_shield.roles.statuses_#{active ? 'active' : 'inactive'}") %>
                                </span>
                                <span class="mt-1 block text-xs leading-5 text-neutral-500">
                                    <%= t("lesli_shield.roles.form_status_#{active ? 'active' : 'inactive'}_hint") %>
                                </span>
                            </span>
                        </label>
                    <% end %>
                </div>
                <%= render "field_errors", record: @role, attribute: :active %>
            </fieldset>
        <% end %>

        <div class="space-y-5 border-t border-neutral-200 pt-6">
            <div>
                <%= form.label :permission_level, t("lesli_shield.roles.fields_permission_level"), class: "block text-sm font-medium text-neutral-700" %>
                <%= form.number_field :permission_level,
                    min: 0,
                    max: current_user.max_level_permission,
                    step: 1,
                    required: true,
                    disabled: !editable,
                    inputmode: "numeric",
                    class: class_names(input_classes, error_input_classes => @role.errors[:permission_level].any?) %>
                <p class="mt-1.5 text-xs leading-5 text-neutral-500">
                    <%= t("lesli_shield.roles.form_permission_level_hint", maximum: current_user.max_level_permission) %>
                </p>
                <%= render "field_errors", record: @role, attribute: :permission_level %>
            </div>

            <div>
                <%= form.label :path_default, t("lesli_shield.roles.fields_path_default"), class: "block text-sm font-medium text-neutral-700" %>
                <%= form.text_field :path_default,
                    disabled: !editable,
                    placeholder: "/dashboard",
                    class: class_names(input_classes, error_input_classes => @role.errors[:path_default].any?) %>
                <p class="mt-1.5 text-xs leading-5 text-neutral-500">
                    <%= t("lesli_shield.roles.form_path_default_hint") %>
                </p>
                <%= render "field_errors", record: @role, attribute: :path_default %>
            </div>
        </div>

        <% if editable %>
            <div class="flex flex-col gap-3 border-t border-neutral-200 pt-6 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <% if @role.persisted? %>
                        <% if @role.active? %>
                            <%= render LesliView::Elements::Button.new(t("lesli_shield.roles.detail_deactivate"),
                                type: "submit",
                                name: "role[active]",
                                value: false,
                                warning: true,
                                data: {
                                    turbo_confirm: t("lesli_shield.roles.detail_confirm_deactivate_#{members_plural}", role: @role.name, count: members_count),
                                    turbo_submits_with: t("lesli_shield.roles.detail_deactivating")
                                }) %>
                        <% else %>
                            <%= render LesliView::Elements::Button.new(t("lesli_shield.roles.detail_activate"),
                                type: "submit",
                                name: "role[active]",
                                value: true,
                                success: true,
                                data: { turbo_submits_with: t("lesli_shield.roles.detail_activating") }) %>
                        <% end %>
                    <% end %>
                </div>

                <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                    <%= render LesliView::Elements::Button.new(t("lesli_shield.roles.form_cancel"),
                        url: @role.persisted? ? role_path(@role) : roles_path,
                        solid: false, data: { turbo_frame: "_top" }) %>
                    <%= render LesliView::Elements::Button.new(@role.persisted? ? t("lesli_shield.roles.action_update") : t("lesli_shield.roles.action_create"),
                        type: :submit, data: { turbo_submits_with: t("lesli_shield.roles.action_saving") }) %>
                </div>
            </div>
        <% else %>
            <div class="rounded-xl border border-warning-200 bg-warning-50 p-4 text-sm leading-6 text-warning-800">
                <%= t("lesli_shield.roles.form_protected_notice") %>
            </div>
        <% end %>
    <% end %>
</div>

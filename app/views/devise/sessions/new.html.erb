%>

<% 

# Check if demo mode is enable on initializer file
if Lesli.config.demo
    resource.email = Lesli.config.company[:email]
    resource.password = Lesli.config.security[:password]
end
%>

<%
title = I18n.t("overrides.lesli_shield.devise/sessions.view_title",
        default: :"lesli_shield.devise/sessions.view_title")
%>

<%= render("devise/shared/application-devise", title: title) do %>

    <% authentication_error = flash[:alert].presence || flash[:error].presence %>

    <%= form_for(
        resource,
        as: resource_name,
        url: user_session_path,
        builder: LesliView::Forms::Builder,
        html: { class: "lesli-login-form" },
        data: { turbo: false }
    ) do |form| %>

        <% if Lesli.config.demo %>
            <%= render("devise/shared/demo") %>
        <% end %>

        <%= form.field_control_email(
            :email,
            label: I18n.t("lesli_shield.devise/sessions.label_email", default: "Email address"),
            category: authentication_error.present? ? :danger : nil,
            icon: "person",
            autofocus: true,
            autocomplete: "email",
            required: true,
            placeholder: Lesli.config.company[:email]
        ) %>

        <%= form.field_control_password(
            :password,
            label: I18n.t("lesli_shield.devise/sessions.label_password", default: "Password"),
            message: authentication_error,
            category: authentication_error.present? ? :danger : nil,
            icon: "key",
            autocomplete: "current-password",
            required: true,
            placeholder: "••••••••"
        ) %>

        <div class="lesli-login-options">
            <% if devise_mapping.rememberable? %>
                <%= form.field_control_checkbox(
                    :remember_me,
                    label: I18n.t("devise.sessions.new.remember_me", default: "Remember me")
                ) %>
            <% end %>

            <%= link_to I18n.t("lesli_shield.devise/sessions.button_forgot_password", default: "Forgot password?"),
                new_user_password_path,
                class: "lesli-login-forgot-password" %>
        </div>

        <% if params[:r].presence %>
            <%= hidden_field_tag "user[redirect]", params[:r] %>
        <% end %>

        <%= form.field_control_button(
            I18n.t("lesli_shield.devise/sessions.button_log_in"),
            { class: "is-fullwidth" },
            icon: "login"
        ) %>

        <% if Lesli.config.security.dig(:allow_registration) %>
            <p class="lesli-login-registration">
                <%= I18n.t("lesli_shield.devise/sessions.view_still_not_registered") %>
                <%= link_to I18n.t("lesli_shield.devise/sessions.button_create_account"),
                    new_user_registration_path %>
            </p>
        <% end %>

    <% end %>
<% end %>

<%= render(
    "devise/shared/application-devise-simple",
    title: I18n.t("lesli_shield.devise/passwords.view_update_title")
) do %>

    <%= form_for(
        resource,
        as: resource_name,
        url: user_password_path,
        html: { class: "text-left", method: :put },
        builder: LesliView::Forms::Builder
    ) do |form| %>

        <p class="mb-6 text-center text-sm leading-6 text-slate-600">
            <%= I18n.t("lesli_shield.devise/passwords.view_update_description") %>
        </p>

        <%= render "devise/shared/error_messages", resource: resource %>

        <%= form.hidden_field :reset_password_token %>

        <%= form.field_control_password(
            :password,
            icon: "key",
            label: I18n.t("lesli_shield.devise/passwords.field_password"),
            message: I18n.t(
                "lesli_shield.devise/passwords.field_password_hint",
                count: @minimum_password_length
            ),
            required: true,
            autofocus: true,
            autocomplete: "new-password",
            minlength: @minimum_password_length,
            value: ""
        ) %>

        <%= form.field_control_password(
            :password_confirmation,
            icon: "key",
            label: I18n.t(
                "lesli_shield.devise/passwords.field_password_confirmation"
            ),
            required: true,
            autocomplete: "new-password",
            minlength: @minimum_password_length,
            value: ""
        ) %>

        <%= form.field_control_button(
            I18n.t("lesli_shield.devise/passwords.button_update_password"),
            {
                class: "is-fullwidth",
                data: {
                    turbo_submits_with: I18n.t(
                        "lesli_shield.devise/passwords.button_updating"
                    )
                }
            },
            icon: "key"
        ) %>
    <% end %>

    <%= render(
        "devise/shared/links",
        login: true,
        password_reset: false,
        magic_link: false,
        otp: false
    ) %>
<% end %>

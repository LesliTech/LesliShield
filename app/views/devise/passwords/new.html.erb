
<%= render("devise/shared/application-devise-simple", title:"Forgot your password?") do %>

    <%= form_for(
        resource, 
        as: resource_name, 
        url: user_password_path(),
        html: { class: "text-center" },
        builder: LesliView::Forms::Builder
        ) do |form| %>

            <%= render "devise/shared/error_messages", resource: resource %>

            <%= form.field_control_email(
                :email, 
                icon: "person_search",
                label: "Enter your email address you use in Lesli. We'll send instructions for setting a new password to your email.") 
            %>

            <%= form.field_control_button("Send me reset password instructions", icon:"mail") %>

            <% if Lesli.config.security.dig(:allow_registration) %>
                <p class="mt-6 text-center text-sm text-slate-600">
                    Still not registered?
                    <%= link_to(
                        "Create account",
                        new_user_registration_path,
                        class: "font-semibold text-[var(--lesli-color-primary)] underline underline-offset-2 hover:opacity-80 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--lesli-color-primary)]"
                    ) %>
                </p> 
            <% end %>
        <% end %>

    <%= render("devise/shared/links", login:true, password_reset:false, magic_link:false, otp:false) %>  
<% end %>

%>

<% 

# Check if demo mode is enable on initializer file
if Lesli.config.demo
    resource.email = Lesli.config.company[:email]
    resource.password = Lesli.config.security[:password]
end
%>

<%
title = I18n.t("overrides.lesli_shield.devise/registrations.view_title",
        default: :"lesli_shield.devise/registrations.view_title")
%>

<%= render("devise/shared/application-devise", title:title) do %>

    <%= form_for(
        resource, 
        as: resource_name, 
        url: user_registration_path,
        builder: LesliView::Forms::Builder
        ) do |form| %>

        <%= form.field_control_email(
            :email,
            label: "E-mail address",
            category: flash.first&.first,
            icon: "person",
            autofocus: true,
            autocomplete: "email",
            required: true,
            placeholder: Lesli.config.company[:email]
        ) %>

        <%= form.field_control_password(
            :password,
            label: I18n.t("lesli_shield.devise/registrations.label_password", default: "Password"),
            message: flash.first&.second,
            category: flash.first&.first,
            icon: "key",
            autocomplete: "new-password",
            required: true,
            placeholder: "••••••••"
        ) %>

        <div class="mb-5 rounded-xl border border-slate-200 bg-slate-50 p-4 text-left text-sm text-slate-600">
            <p class="font-medium text-slate-700">
                <%= I18n.t("lesli_shield.devise/registrations.view_password_requirements") %>
            </p>
            <ul class="mt-2 list-disc space-y-1 pl-5">
                <li><%= I18n.t("lesli_shield.devise/registrations.view_password_requirements_uppercase") %></li>
                <li><%= I18n.t("lesli_shield.dashboards.view_password_requirements_symbol") %></li>
                <li><%= I18n.t("lesli_shield.dashboards.view_password_requirements_number") %></li>
            </ul>
        </div>

        <div class="mb-4">
            <p class="text-left text-xs leading-5 text-slate-500">
                By creating an account, you agree to our
                <span class="font-semibold text-[var(--lesli-color-primary)]">Terms</span>
                and have read and acknowledge the
                <span class="font-semibold text-[var(--lesli-color-primary)]">Global Privacy Statement</span>.
            </p>
        </div>

        <%= form.field_control_button(
            I18n.t(
                "overrides.lesli_shield.devise/registrations.button_create_account",
                default: :"lesli_shield.devise/registrations.button_create_account"
            ),
            { class: "w-full" }
        ) %>

        <p class="mt-1 text-center text-sm text-slate-600">
            <%= I18n.t("lesli_shield.devise/registrations.view_already_have_an_account") %>
            <%= link_to(
                I18n.t("lesli_shield.devise/registrations.button_login"),
                new_user_session_path,
                class: "font-semibold text-[var(--lesli-color-primary)] underline underline-offset-2 hover:opacity-80 focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--lesli-color-primary)]"
            ) %>
        </p> 
    <% end %>
<% end %>

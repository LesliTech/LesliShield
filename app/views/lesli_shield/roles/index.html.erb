
<%= render LesliView::Layout::Container.new("shield-roles") do %>
    <%= render LesliView::Components::Header.new(
        t("lesli_shield.roles.title"),
        t("lesli_shield.roles.subtitle")
    ) do %>
        <%= render(LesliView::Elements::Button.new(t("lesli_shield.roles.action_create"), :icon=>'add', :url=>new_role_path)) %>
    <% end %>

    <%= render "filters", filters: @filters %>

    <% if @roles.fetch(:records).any? %>
        <%= render "role_list", roles: @roles.fetch(:records) %>
        <%= render "pagination", pagination: @roles.fetch(:pagination) %>
    <% else %>
        <%= render "empty_state", filters: @filters %>
    <% end %>
<% end %>

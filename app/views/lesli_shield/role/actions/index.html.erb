<%= render LesliView::Layout::Container.new("shield-role-actions") do %>
    <%= render LesliView::Components::Header.new(
        t("lesli_shield.roles.permissions.title", role: @role.name),
        back: role_path(@role)
    ) do %>
        <%= render(LesliView::Elements::Button.new(
            t("lesli_shield.roles.permissions.deploy"),
            solid:true, 
            danger:true,
            icon: 'shield', 
            url: deploy_role_path(@role.id),
            method: :post
        )) %>
    <% end %>
    <p class="mb-6 text-sm text-gray-600">
        <%= t("lesli_shield.roles.permissions.description") %>
    </p>
    <%= render "form" %>
<% end %> 

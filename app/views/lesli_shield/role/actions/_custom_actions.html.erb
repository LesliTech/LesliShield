<div class="divide-y divide-slate-200 border-t border-slate-200" data-custom-actions>
    <h3 class="px-4 py-3 text-sm font-semibold text-slate-900 sm:px-5">
        <%= t("lesli_shield.roles.permissions_custom_actions") %>
    </h3>
    <% resources.each do |resource| %>
        <fieldset class="px-4 py-5 sm:px-5">
            <legend class="w-full">
                <span class="block text-sm font-semibold text-slate-900"><%= resource[:label] %></span>
                <span class="mt-0.5 block break-all font-mono text-xs text-slate-500"><%= resource[:route] %></span>
            </legend>
            <div class="mt-4 grid gap-3 sm:grid-cols-2 xl:grid-cols-3">
                <% resource[:actions].reject { |action| action[:standard] }.each do |action| %>
                    <div class="flex min-h-14 items-start gap-3 rounded-xl border border-slate-200 bg-white p-3">
                        <%= render "toggle", action: action %>
                        <span class="min-w-0 flex-1">
                            <span class="block text-sm font-semibold text-slate-900"><%= action[:display_label] %></span>
                            <span class="mt-0.5 block break-all font-mono text-xs text-slate-500"><%= action[:action] %></span>
                        </span>
                    </div>
                <% end %>
            </div>
        </fieldset>
    <% end %>
</div>
